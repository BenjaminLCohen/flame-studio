{
 "headers": [
  {
   "source": "/data/(.*)\\.bin\\.gz",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/octet-stream"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/data/(.*)\\.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  }
 ],
 "cleanUrls": true
}